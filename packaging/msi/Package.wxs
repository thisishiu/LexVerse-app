<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="LexVerse" Manufacturer="LexVerse" Version="$(var.Version)"
           UpgradeCode="833035A8-3B1B-44D6-BB54-EC1C74F01D77" Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of LexVerse is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="Installed OR (VersionNT64 AND WindowsBuild &gt;= 19041)"
            Message="LexVerse requires Windows 10 version 2004 (build 19041) or later, x64." />
    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\LexVerse.App.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LexVerse" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="LexVerse">
        <Component Id="StartMenu" Guid="8BF3C7AA-4909-4502-B37D-45D9E0277925">
          <Shortcut Id="AppShortcut" Name="LexVerse" Target="[INSTALLFOLDER]LexVerse.App.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <RemoveFolder Id="RemoveMenu" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\LexVerse\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="LexVerse" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
