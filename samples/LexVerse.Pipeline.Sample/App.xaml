<Application x:Class="LexVerse.Pipeline.Sample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#FBFCFE"/>
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputRaisedBrush" Color="#FFF9F3"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#17243D"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#DEE5EE"/>
        <SolidColorBrush x:Key="StrongStrokeBrush" Color="#CDD6E1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#60708A"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="#8D9AAF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF7A00"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#F06F00"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#D86200"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#FFF3E8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2EAE49"/>
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F8EC"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF1E7"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D92D20"/>
        <SolidColorBrush x:Key="WhiteTextBrush" Color="#17243D"/>
        <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OverlayScrimBrush" Color="#66172033"/>

        <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF8A00" Offset="0"/>
            <GradientStop Color="#FF7000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFC247" Offset="0"/>
            <GradientStop Color="#FF7A00" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadowEffect"
                          Color="#24374A5C"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.12"/>
        <DropShadowEffect x:Key="WindowShadowEffect"
                          Color="#3D26364A"
                          BlurRadius="26"
                          ShadowDepth="6"
                          Opacity="0.24"/>
        <DropShadowEffect x:Key="ActionShadowEffect"
                          Color="#55FF7900"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.28"/>
        <DropShadowEffect x:Key="IconShadowEffect"
                          Color="#45FF7900"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Opacity="0.24"/>
        <DropShadowEffect x:Key="FlyoutShadowEffect"
                          Color="#3323384D"
                          BlurRadius="28"
                          ShadowDepth="6"
                          Opacity="0.22"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Application.Resources>
</Application>
