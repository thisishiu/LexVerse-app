                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Status: Ready. Highlight text and press F6, or choose Region / Full screen."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="v2.4.1"
                                   Foreground="{StaticResource DimTextBrush}"
                                   FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="SettingsOverlay"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              Background="{StaticResource OverlayScrimBrush}"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              MouseLeftButtonDown="SettingsOverlay_MouseLeftButtonDown">
            <Border Width="540"
                    HorizontalAlignment="Right"
                    Margin="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="24"
                    Effect="{StaticResource FlyoutShadowEffect}"
                    MouseLeftButtonDown="SettingsPanel_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SettingsTitleText"
                                       Text="Settings"
                                       Foreground="{StaticResource WhiteTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="SettingsSubtitleText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       Text="Language and shortcuts"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource WindowChromeButton}"
                                AutomationProperties.Name="Close settings"
                                ToolTip="Close settings"
                                Click="CloseSettings_Click">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,28,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SettingsLanguageTitleText"
                                       Style="{StaticResource SectionLabelText}"
                                       Text="LANGUAGE"/>
                            <TextBlock x:Name="AppLanguageLabelText"
                                       Margin="0,14,0,8"
                                       Foreground="{StaticResource WhiteTextBrush}"
                                       Text="App language"/>
                            <ComboBox x:Name="AppLanguageBox"
                                      Style="{StaticResource LightComboBox}"
                                      SelectionChanged="AppLanguageBox_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                            </ComboBox>

                            <Border Height="1"
                                    Background="{StaticResource StrokeBrush}"
                                    Margin="0,28,0,22"/>

                            <TextBlock x:Name="SettingsShortcutsTitleText"
                                       Style="{StaticResource SectionLabelText}"
                                       Text="SHORTCUTS"/>
                            <TextBlock x:Name="ShortcutHintText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,10,0,18"
                                       Text="Click a shortcut, then press the new key combination."/>

                            <StackPanel>
                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PopupShortcutLabelText"
                                                   Text="Popup translate"
                                                   Foreground="{StaticResource WhiteTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="PopupShortcutButton"
                                                Grid.Column="1"
                                                Style="{StaticResource ShortcutButton}"
                                                Tag="PopupTranslate"
                                                Click="ShortcutButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RegionShortcutLabelText"
                                                   Text="Region translate"
                                                   Foreground="{StaticResource WhiteTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="RegionShortcutButton"
                                                Grid.Column="1"
                                                Style="{StaticResource ShortcutButton}"
                                                Tag="RegionTranslate"
                                                Click="ShortcutButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FullScreenShortcutLabelText"
                                                   Text="Full screen realtime"
                                                   Foreground="{StaticResource WhiteTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="FullScreenShortcutButton"
                                                Grid.Column="1"
                                                Style="{StaticResource ShortcutButton}"
                                                Tag="FullScreenRealtime"
                                                Click="ShortcutButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StopShortcutLabelText"
                                                   Text="Stop realtime"
                                                   Foreground="{StaticResource WhiteTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="StopShortcutButton"
                                                Grid.Column="1"
                                                Style="{StaticResource ShortcutButton}"
                                                Tag="StopRealtime"
                                                Click="ShortcutButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ResetShortcutLabelText"
                                                   Text="Reset / clear overlay"
                                                   Foreground="{StaticResource WhiteTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="ResetShortcutButton"
                                                Grid.Column="1"
                                                Style="{StaticResource ShortcutButton}"
                                                Tag="ResetOverlay"
                                                Click="ShortcutButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="ShortcutErrorText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,18,0,0"
                                       Text=""/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
