<Window x:Class="LexVerse.Pipeline.Sample.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PopupIconButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="#FFB36B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeywordChipButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
            <Setter Property="BorderBrush" Value="#FFD1A8"/>
            <Setter Property="Foreground" Value="#9A4500"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeywordChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeywordChipBorder" Property="Background" Value="#FFE4CC"/>
                                <Setter TargetName="KeywordChipBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeywordChipBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="KeywordChipBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PopupShell"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource FlyoutShadowEffect}"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="PopupShell_MouseLeftButtonDown"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TranslateTransform Y="10"/>
        </Border.RenderTransform>
        <StackPanel MinWidth="420"
                    MaxWidth="620">
            <Grid x:Name="HeaderBar"
                  Background="{StaticResource SurfaceRaisedBrush}"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Lexverse translate"
                           Foreground="{StaticResource WhiteTextBrush}"
                           FontWeight="Bold"
                           Margin="18,12"/>
                <Button Grid.Column="1"
                        Style="{StaticResource PopupIconButton}"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Margin="0,8,12,8"
                        Click="Close_Click">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"/>
                </Button>
            </Grid>

            <StackPanel x:Name="LoadingPanel"
                        Margin="20,18,20,20">
                <TextBlock x:Name="LoadingText"
                           Text="Translating selected text..."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           TextWrapping="Wrap"/>
                <ProgressBar Height="4"
                             Margin="0,12,0,0"
                             IsIndeterminate="True"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="#FFE4CC"
                             BorderThickness="0"/>
            </StackPanel>

            <StackPanel x:Name="ResultPanel"
                        Visibility="Collapsed"
                        Margin="20,16,20,20">
                <TextBlock Text="Original"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,8"/>
                <Border Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <TextBlock x:Name="SourceTextBlock"
                               Foreground="{StaticResource WhiteTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </Border>

                <TextBlock x:Name="TargetLabel"
                           Text="Vietnamese"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontWeight="SemiBold"
                           Margin="0,16,0,8"/>
                <Border Background="{StaticResource PrimarySoftBrush}"
                        BorderBrush="#FFD1A8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <TextBlock x:Name="TranslatedTextBlock"
                               Foreground="{StaticResource WhiteTextBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               LineHeight="24"/>
                </Border>

                <Border x:Name="KeywordPanel"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Important terms"
                                   Foreground="{StaticResource WhiteTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <WrapPanel x:Name="KeywordItemsPanel"/>

                        <Border x:Name="KeywordDetailPanel"
                                Visibility="Collapsed"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="#FFD1A8"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="KeywordDetailTitle"
                                           Foreground="#9A4500"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="KeywordDetailText"
                                           Foreground="{StaticResource WhiteTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="22"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
