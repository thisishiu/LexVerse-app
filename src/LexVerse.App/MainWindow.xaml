<Window x:Class="LexVerse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lexverse" Height="700" Width="1160"
        MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#FF17150F"
        Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Assets/logo-lexverse.jpg" Stretch="UniformToFill" Opacity="0.05" />
        </Grid.Background>

        <Border Background="#F51B1912">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="58" Height="58" CornerRadius="10" Background="#FF2A261D" BorderBrush="#FF5B503F" BorderThickness="1" Padding="6">
                            <Image Source="Assets/logo.jpg" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Lexverse" FontSize="36" FontWeight="Bold" />
                            <TextBlock Text="Control center" Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Popup F6" Style="{StaticResource PrimaryButton}" Click="ActivatePopup_Click" ToolTip="Select a region and open the rich translation popup." />
                        <Button x:Name="RealtimeButton" Content="Start realtime" Margin="10,0,0,0" Click="StartRealtime_Click" ToolTip="Select a region and keep translating it." />
                        <Button x:Name="StopRealtimeButton" Content="Stop" Margin="10,0,0,0" Click="StopRealtime_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,26,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#FF4D4436" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Language" FontSize="21" FontWeight="Bold" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="From" Foreground="{StaticResource MutedInkBrush}" />
                                        <ComboBox x:Name="SourceLanguageBox" SelectedIndex="0" Margin="0,6,0,0">
                                            <ComboBoxItem Content="English" Tag="en" />
                                            <ComboBoxItem Content="Auto detect" Tag="auto" />
                                            <ComboBoxItem Content="Japanese" Tag="ja" />
                                            <ComboBoxItem Content="Korean" Tag="ko" />
                                            <ComboBoxItem Content="Chinese" Tag="zh" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="To" Foreground="{StaticResource MutedInkBrush}" />
                                        <ComboBox x:Name="TargetLanguageBox" SelectedIndex="0" Margin="0,6,0,0">
                                            <ComboBoxItem Content="Vietnamese" Tag="vi" />
                                            <ComboBoxItem Content="English" Tag="en" />
                                            <ComboBoxItem Content="Japanese" Tag="ja" />
                                            <ComboBoxItem Content="Korean" Tag="ko" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Ignored terms" Foreground="{StaticResource MutedInkBrush}" Margin="0,18,0,8" />
                                <TextBox x:Name="IgnoredTermsBox"
                                         MinHeight="82"
                                         TextWrapping="Wrap"
                                         Background="#FF211E17"
                                         Foreground="{StaticResource InkBrush}"
                                         BorderBrush="#FF5A4B3B"
                                         Padding="10" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelSoftBrush}" BorderBrush="#FF5A4B3B" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Behavior" FontSize="21" FontWeight="Bold" />
                                <CheckBox x:Name="KeepTermsCheck" Content="Keep acronyms/technical terms" IsChecked="True" />
                                <CheckBox x:Name="ClickAwayCheck" Content="Close popup on outside click" IsChecked="True" />
                                <CheckBox x:Name="MovablePopupCheck" Content="Allow dragging popup" IsChecked="True" />
                                <CheckBox x:Name="FastPopupCheck" Content="Show popup before translation finishes" IsChecked="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#FF242219" BorderBrush="#FF504636" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Popup Mode" FontSize="21" FontWeight="Bold" />
                                    <TextBlock Text="Bedrock" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,12" />
                                    <UniformGrid Columns="2">
                                        <Button Content="Capture" Style="{StaticResource PrimaryButton}" Click="ActivatePopup_Click" Margin="0,0,8,0" />
                                        <Button Content="Preview" Click="ShowDemo_Click" Margin="8,0,0,0" />
                                    </UniformGrid>
                                    <TextBlock x:Name="ProviderStatusText" Text="Rich popup uses OCR plus Bedrock mapping." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FF242219" BorderBrush="#FF504636" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Realtime Mode" FontSize="21" FontWeight="Bold" />
                                    <TextBlock Text="Windows OCR + Google Translate" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,12" />
                                    <UniformGrid Columns="2">
                                        <Button Content="Select region" Click="StartRealtime_Click" Margin="0,0,8,0" />
                                        <Button Content="Stop" Click="StopRealtime_Click" Margin="8,0,0,0" />
                                    </UniformGrid>
                                    <TextBlock x:Name="RealtimeStatusText" Text="Idle" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="#FF4D4436" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Realtime Tuning" FontSize="22" FontWeight="Bold" />

                                    <TextBlock Text="Scan interval" Foreground="{StaticResource MutedInkBrush}" Margin="0,18,0,6" />
                                    <Slider x:Name="RealtimeIntervalSlider" Minimum="500" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" Value="1600" />

                                    <TextBlock Text="Overlay opacity" Foreground="{StaticResource MutedInkBrush}" Margin="0,16,0,6" />
                                    <Slider x:Name="RealtimeOpacitySlider" Minimum="0.45" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="0.92" />

                                    <TextBlock Text="Text size" Foreground="{StaticResource MutedInkBrush}" Margin="0,16,0,6" />
                                    <Slider x:Name="RealtimeFontSizeSlider" Minimum="11" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="16" />

                                    <TextBlock Text="Max OCR fragments" Foreground="{StaticResource MutedInkBrush}" Margin="0,16,0,6" />
                                    <Slider x:Name="RealtimeMaxSegmentsSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="12" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#FF4D4436" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Runtime" FontSize="22" FontWeight="Bold" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Hotkey" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock x:Name="HotkeyStatusText" Grid.Column="1" Text="Registering F6..." TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" Text="Popup" Foreground="{StaticResource MutedInkBrush}" Margin="0,14,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="F6 capture, Bedrock structured result" TextWrapping="Wrap" Margin="0,14,0,0" />

                                        <TextBlock Grid.Row="2" Text="Realtime" Foreground="{StaticResource MutedInkBrush}" Margin="0,14,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Region OCR loop with text-only translation" TextWrapping="Wrap" Margin="0,14,0,0" />

                                        <TextBlock Grid.Row="3" Text="Overlay" Foreground="{StaticResource MutedInkBrush}" Margin="0,14,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Click-through, placed outside the captured region when possible" TextWrapping="Wrap" Margin="0,14,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="#FF242219" BorderBrush="#FF504636" BorderThickness="1" CornerRadius="8" Padding="14,11">
                    <DockPanel>
                        <Ellipse Width="9" Height="9" Fill="#FF8AA66B" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="Status: Starting Lexverse."
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedInkBrush}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
