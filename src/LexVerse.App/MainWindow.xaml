<Window x:Class="LexVerse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="LexVerse Control Center"
        Width="980"
        Height="650"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="LexVerse Control Center"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Border x:Name="StartupLoadingPanel" Background="{StaticResource BackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="LexVerse" Foreground="{StaticResource TextBrush}"
                           FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StartupMessage" Text="Loading workspace..." TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,12,0,16" HorizontalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="StartupProgress" IsIndeterminate="True" Width="220" Height="4"
                             AutomationProperties.Name="Loading workspace"/>
                <Button x:Name="StartupCloseButton" Content="Close" Click="CloseStartup_Click" Visibility="Collapsed" Margin="0,16,0,0" Width="100"/>
            </StackPanel>
        </Border>

        <wv2:WebView2 x:Name="WebUi"
                      Visibility="Hidden"
                      AutomationProperties.Name="LexVerse web control center" />
    </Grid>
</Window>
