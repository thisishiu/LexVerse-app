<Window x:Class="LexVerse.App.RealtimeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Shell"
            Background="#E8242119"
            BorderBrush="#B8B4865D"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,8"
            MaxWidth="720"
            Opacity="0.92">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="8" Opacity="0.35" Color="#FF000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Realtime"
                           Foreground="#FFD8C8AE"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <TextBlock x:Name="PulseText"
                           Grid.Column="1"
                           Text="watching"
                           Foreground="#FF9CAB83"
                           FontSize="12" />
            </Grid>
            <TextBlock x:Name="TranslationText"
                       Foreground="#FFFFF5E8"
                       FontFamily="Segoe UI, Arial"
                       FontSize="16"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       MaxWidth="680" />
        </StackPanel>
    </Border>
</Window>
