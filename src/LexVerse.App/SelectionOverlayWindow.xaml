<Window x:Class="LexVerse.App.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#42000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas">
        <Border x:Name="SelectionBorder"
                Visibility="Collapsed"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                Background="#33FF7A00"
                CornerRadius="5"/>
        <Border x:Name="SelectionSizeBadge"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4">
            <TextBlock x:Name="SelectionSizeText"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="Hint"
                Canvas.Left="28"
                Canvas.Top="28"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Effect="{StaticResource FlyoutShadowEffect}">
            <StackPanel>
                <TextBlock Text="Select a realtime translation region"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Drag around text · Esc to cancel"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
