<Window x:Class="LexVerse.App.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Opacity="0"
        Loaded="Window_Loaded">
    <Border x:Name="PopupShell"
            Background="#F227251E"
            BorderBrush="#FFC69B67"
            BorderThickness="2"
            CornerRadius="14"
            Padding="18"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TranslateTransform Y="10" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.42" Color="#FF0D0B08" />
        </Border.Effect>

        <StackPanel MinWidth="420" MaxWidth="760">
            <Grid x:Name="HeaderBar"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Lexverse translate" Foreground="#FFF7F1E7" FontWeight="Bold" FontSize="17" />
                <Button Grid.Column="1" Content="x" Width="28" Height="28" Padding="0" Click="Close_Click" />
            </Grid>

            <StackPanel x:Name="LoadingPanel" Margin="0,16,0,0">
                <TextBlock x:Name="LoadingText"
                           Text="Translating..."
                           Foreground="#FFF7F1E7"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <ProgressBar Height="4"
                             Margin="0,12,0,0"
                             IsIndeterminate="True"
                             Foreground="#FFC69B67"
                             Background="#33211E17"
                             BorderThickness="0" />
            </StackPanel>

            <TextBlock x:Name="SourceLabel" Text="Source" Foreground="#FFC8BBA8" Margin="0,16,0,6" />
            <Border x:Name="SourceSection" Background="#33211E17" BorderBrush="#445A4B3B" BorderThickness="1" CornerRadius="8" Padding="12">
                <TextBlock x:Name="SourceTextBlock"
                           Foreground="#FFE4D8C5"
                           FontSize="15"
                           TextWrapping="Wrap"
                           LineHeight="22" />
            </Border>

            <TextBlock x:Name="TranslatedLabel" Text="Vietnamese" Foreground="#FFC8BBA8" Margin="0,16,0,6" />
            <Border x:Name="TranslatedSection" Background="#22211E17" BorderBrush="#335A4B3B" BorderThickness="1" CornerRadius="8" Padding="8">
                <ScrollViewer MaxHeight="360"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel x:Name="TranslatedItemsPanel" />
                </ScrollViewer>
            </Border>

            <Border x:Name="KeywordDetailPanel"
                    Visibility="Collapsed"
                    Background="#FF332D22"
                    BorderBrush="#FF7E6548"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="KeywordTitle"
                               Foreground="#FFF7F1E7"
                               FontSize="16"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="KeywordBody"
                               Foreground="#FFE4D8C5"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
