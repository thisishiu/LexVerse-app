<Window x:Class="LexVerse.App.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None" ResizeMode="NoResize" Background="#FFFFFF"
        Topmost="True" ShowInTaskbar="False" Width="520" Height="180" Opacity="0"
        FontFamily="pack://application:,,,/LexVerse.App;component/Fonts/#Be Vietnam Pro" Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#242428"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64646E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#29292E"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C93C37"/>
        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#242428"/>
            <Setter Property="BorderBrush" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDEDF0"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#29292E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="{StaticResource SurfaceRaisedBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock Text="LexVerse" Margin="18,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                <Button x:Name="CopyButton" Grid.Column="1" Content="Copy" Padding="10,5" Margin="0,7" Visibility="Collapsed" Style="{StaticResource PopupButton}" Click="Copy_Click"/>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource PopupButton}" Content="&#xE711;" AutomationProperties.Name="Close" ToolTip="Close" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>
            <Border x:Name="LoadingPanel" Grid.Row="1" Panel.ZIndex="1" Background="#FFFFFF">
              <StackPanel Margin="20">
                <TextBlock x:Name="LoadingText" Text="Translating…" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,14"/>
                <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
              </StackPanel>
            </Border>
            <wv:WebView2CompositionControl x:Name="ResultView" Grid.Row="1" Visibility="Collapsed" DefaultBackgroundColor="#FFFFFF"/>
            <ScrollViewer x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,20">
                    <TextBlock x:Name="ErrorTitle" Foreground="{StaticResource DangerBrush}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorMessage" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
