<Window x:Class="LexVerse.App.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Width="520"
        Opacity="0"
        Loaded="Window_Loaded">
    <Border x:Name="PopupShell"
            MinWidth="440"
            MaxWidth="620"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource FlyoutShadowEffect}">
        <StackPanel>
            <Grid Background="{StaticResource SurfaceRaisedBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="18,12">
                    <TextBlock Text="LexVerse" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Popup translation" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{StaticResource TextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="42"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <StackPanel x:Name="LoadingPanel" Margin="20">
                <TextBlock Text="Translating…" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                <TextBlock Text="This usually takes only a moment." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,12"/>
                <ProgressBar Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#FFE4CC" BorderThickness="0"/>
            </StackPanel>

            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock x:Name="SourceLabel" Text="Original" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="SourceTextBlock" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxHeight="120" Margin="0,7,0,16"/>
                <TextBlock x:Name="TargetLabel" Text="Translation" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="TranslatedTextBlock" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="25" Margin="0,7,0,16"/>
                <Button x:Name="CopyButton"
                        Content="Copy translation"
                        HorizontalAlignment="Left"
                        Padding="12,7"
                        Style="{StaticResource SecondaryButton}"
                        Cursor="Hand"
                        Click="Copy_Click"/>
            </StackPanel>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock x:Name="ErrorTitle" Foreground="{StaticResource DangerBrush}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="ErrorMessage" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
