<Window x:Class="LexVerse.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LexVerse.Overlay"
        xmlns:converters="clr-namespace:LexVerse.Overlay.Converters"
        mc:Ignorable="d"
        Title="LexVerse Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Height="600"
        Width="800">
    <Window.Resources>
        <converters:BoolToTextWrappingConverter x:Key="BoolToWrap"/>
        <DropShadowEffect x:Key="DropShadow"
                Color="Black"
                BlurRadius="6"
                Opacity="0.6"/>
    </Window.Resources>

    <Grid>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsHitTestVisible="False"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Background, FallbackValue=#80000000}"
                            Padding="6"
                            CornerRadius="6">
                        <TextBlock Text="{Binding Text}"
                                   FontSize="{Binding FontSize}"
                                   Foreground="{Binding Foreground, FallbackValue=White}"
                                   FontWeight="Bold"
                                   TextWrapping="{Binding Wrap, Converter={StaticResource BoolToWrap}}"
                                   MaxWidth="{Binding MaxWidth}"
                                   Effect="{StaticResource DropShadow}"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left"
                            Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"
                            Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </Grid>
</Window>
